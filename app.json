{
  "expo": {
    "name": "Berzh Mate",
    "slug": "berzh-mate",
    "scheme": "berzhmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "Berzh Mate uses your location to guide you and reroute when you go off course.",
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true
      }]
    ],
    "android": {
      "package": "com.devthanseemx.berzhmate",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    }
  }
}